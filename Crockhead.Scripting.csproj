<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>0.0.3</Version>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>disable</Nullable>
		<ProduceReferenceAssembly>True</ProduceReferenceAssembly>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageId>Crockhead.Scripting</PackageId>
		<Product>$(PackageId)</Product>
		<Title>$(PackageId)</Title>
		<AssemblyName>$(PackageId)</AssemblyName>
		<Company>Crockhead Studio</Company>
		<Authors>ddukbaek2</Authors>
		<Description>Lightweight scripting engine for .NET Standard 2.1 with a simple syntax and stack-based execution model. Supports function binding between C# and script code with no external dependencies.</Description>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/ddukbaek2/Crockhead.Scripting.git</RepositoryUrl>
		<!-- <PackageLicenseExpression>MIT</PackageLicenseExpression> -->
		<!-- <LicenseExpression>$(PackageLicenseExpression)</LicenseExpression> -->
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageTags>core;utility;base</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/ddukbaek2/Crockhead.Scripting</PackageProjectUrl>
		<ProjectUrl>$(PackageProjectUrl)</ProjectUrl>
		<PackageDirectory>$(MSBuildProjectDirectory)\bin\$(Configuration)\</PackageDirectory>
		<DeployOnBuild>True</DeployOnBuild>
		<DistOnPack>True</DistOnPack>
		<OutputDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\</OutputDir>
		<LibraryFilePath>$(OutputDir)$(AssemblyName).dll</LibraryFilePath>
		<DocumentFilePath>$(OutputDir)$(AssemblyName).xml</DocumentFilePath>
		<Configurations>Debug;Release;Distribution</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Crockhead.Core" Version="0.0.19" />
	</ItemGroup>

	<Target Name="RemoveAllPackages" BeforeTargets="Build;Pack">
		<ItemGroup>
			<PackageFilePattern Include="$(PackageDirectory)*.nupkg" />
			<SymbolPackageFilePattern Include="$(PackageDirectory)*.snupkg" />
		</ItemGroup>
		<Delete Files="@(PackageFilePattern);@(SymbolPackageFilePattern)" />
	</Target>

	<Target Name="Deployment" AfterTargets="Build" Condition="('$(Configuration)'=='Release' or '$(Configuration)'=='Distribution') and '$(DeployOnBuild)'=='True'">
		<Exec Command="deployment.bat $(DocumentFilePath) $(LibraryFilePath)" WorkingDirectory="$(ProjectDir)" />
	</Target>
	<Target Name="Distribution" AfterTargets="Pack" Condition="'$(Configuration)'=='Distribution' and '$(DistOnPack)'=='True'">
		<Exec Command="distribution.bat" WorkingDirectory="$(ProjectDir)" />
	</Target>

</Project>